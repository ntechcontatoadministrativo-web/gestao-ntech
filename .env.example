# ---------------------------------------------------------------------
# Banco de dados (Postgres — ex.: Neon)
#   DATABASE_URL -> conexão com pooler (tempo de execução)
#   DATABASE_URL_UNPOOLED -> conexão direta (migrations / db push)
# ---------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host/banco?sslmode=require"

# URL pública do sistema, sem barra no final
APP_URL="http://localhost:3000"

# Segredo da sessão (openssl rand -hex 32)
SESSION_SECRET=""

# Chave para criptografar os tokens do Google no banco (openssl rand -hex 32)
# ATENÇÃO: se perder, será preciso reconectar o Google Drive.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------
# Google Drive (OAuth) — console.cloud.google.com > APIs e serviços
#   1. Ative a "Google Drive API"
#   2. Credenciais > ID do cliente OAuth > Aplicativo da Web
#   3. URI de redirecionamento: {APP_URL}/api/google/callback
# Sem estas variáveis o sistema guarda os arquivos localmente (modo demonstração).
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Primeiro gestor (usado por `npm run db:seed`)
ADMIN_NOME="Gestor"
ADMIN_EMAIL="gestor@ntech.dev.br"
ADMIN_SENHA="troque-esta-senha"

# IA (assistente e escopo) — console.anthropic.com > API keys
ANTHROPIC_API_KEY=""

# WhatsApp automático (z-api.io) — opcional
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
ZAPI_CLIENT_TOKEN=""
